# --- The Ajo agent ---------------------------------------------------------

# Anthropic key powers the plain-language advisor (/advise).
# Get one at https://console.anthropic.com. The app still works without it —
# it falls back to a local advisor — but real natural language needs this.
ANTHROPIC_API_KEY=

# BOT Chain Mainnet.
BOTCHAIN_RPC=https://rpc.botchain.ai
# Paste the address printed by `npm run deploy` in the ../ (contracts) project.
AJO_CONTRACT=

# OPTIONAL — the autonomous keeper.
# If you set a funded key here, the agent watches every circle and, the instant
# a round is fully funded, it calls disburse() itself so no member ever has to.
# Leave blank to run advice-only (recommended until you've tested manually).
AGENT_PRIVATE_KEY=

PORT=8787
